    "foaf:name": "Deltares"
  },
  "dcat:dataset": [
    {
      "@id": "https://partners.example/deltares/dataset/fto-ghg-horticulture",
      "@type": "dcat:Dataset",
      "dct:identifier": "fto-ghg-horticulture",
      "dct:title": "Greenhouse gas emissions in Dutch horticulture (FTO Duurzaamheid, mock)",
      "dct:description": "Modelled CO2, CH4 and N2O emissions for greenhouse horticulture regions, annual resolution.",
      "dcat:keyword": [
        "greenhouse gas",
        "emissions",
        "CO2",
        "horticulture",
        "sustainability"
      ],
      "dcat:theme": [
