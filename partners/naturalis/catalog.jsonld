      ],
      "dct:identifier": "ibol-europe-gaplist-app",
      "dct:title": "iBOL Europe / BGE gap-list app",
      "dct:description": "Aggregates the BGE target list, synonyms, BOLD workbench exports and the public BOLD data package (COI-5P) into a normalised SQLite database. Its reports show the status of BGE barcoding activities and update the iBOL Europe target list web application. Proof of concept; the README disclaims ongoing maintenance.",
      "dcat:keyword": [
        "DNA barcoding",
        "BOLD",
        "target list",
        "biodiversity",
        "COI-5P"
      ],
