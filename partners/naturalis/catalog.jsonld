  "dcat:resource": [
    {
      "@id": "https://partners.example/naturalis/software/sdmdl",
      "@type": [
        "dcat:Resource",
        "schema:SoftwareSourceCode"
      ],
      "dct:identifier": "sdmdl",
      "dct:title": "sdmdl — Species Distribution Modelling using Deep Learning",
      "dct:description": "Python package that trains deep neural network classifiers on species occurrence records and environmental raster layers, estimates variable importance with SHAP, and produces prediction maps (GeoTIFF). Presented as an alternative to MaxEnt. Inputs: occurrence tables (WGS 84 lat/lon) and environmental rasters; outputs: per-species models, metrics, SHAP plots, maps.",
      "dcat:keyword": [
        "species distribution modelling",
        "deep learning",
        "biodiversity",
        "occurrences",
        "SHAP"
      ],
      "dcat:theme": [
        "http://publications.europa.eu/resource/authority/data-theme/ENVI"
      ],
      "dct:license": "https://spdx.org/licenses/MIT",
      "dcat:landingPage": "https://github.com/naturalis/sdmdl",
      "schema:codeRepository": "https://github.com/naturalis/sdmdl",
      "schema:programmingLanguage": "Python",
      "dct:relation": [
        "https://doi.org/10.1101/744441",
        "https://zenodo.org/records/3460541",
        "https://zenodo.org/records/3460530",
        "https://zenodo.org/records/3460718"
      ],
